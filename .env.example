# iCloud Shared Album
# Get this from your shared album's public URL
# e.g., https://www.icloud.com/sharedalbum/#ABC123DEF456 -> ABC123DEF456
ICLOUD_ALBUM_TOKEN=ABC123DEF456

# Number of retry attempts for iCloud photo downloads (default: 3)
# ICLOUD_DOWNLOAD_MAX_RETRIES=3

# Amazon Photos — device registration
# Sign in once at http://<host>:3000/amazon. The app registers a device with
# Amazon and keeps a long-lived token, then mints its own cookies from it.

# Where the registration and minted cookies are stored (mount this directory)
# AMAZON_AUTH_PATH=./data/amazon-auth.json

# Marketplace. Set this before registering: the underlying library defaults to
# Germany, and a registration made against the wrong marketplace can only be
# fixed by registering again in a browser.
# AMAZON_MARKETPLACE=amazon.com
# AMAZON_ACCEPT_LANGUAGE=en-US
# AMAZON_PROXY_LANGUAGE=en_US

# Name this device appears under at amazon.com/mycd
# AMAZON_DEVICE_APP_NAME=alexa-photos

# REQUIRED IN DOCKER. The address your browser uses to reach the login proxy.
# Must be an IP literal, not a hostname. Auto-detection inside a container
# returns the bridge address, which no browser can reach, and the proxy still
# appears to start, so sign-in fails with no useful error.
# AMAZON_PROXY_OWN_IP=192.168.1.50
# AMAZON_PROXY_PORT=3456
# AMAZON_PROXY_LISTEN_BIND=0.0.0.0
# How long the login proxy waits for you to finish signing in
# AMAZON_REGISTRATION_TIMEOUT_MINUTES=10

# Refresh cookies only once they are older than this. They last about 14 days.
# AMAZON_COOKIE_MAX_AGE_DAYS=7

# Automatically refresh expired auth tokens using session cookies (default: true)
# AMAZON_AUTO_REFRESH_COOKIES=true

# How often to check whether cookies need refreshing (default: 12 hours).
# This is a check interval, not a refresh interval: a refresh only happens once
# cookies pass AMAZON_COOKIE_MAX_AGE_DAYS.
# COOKIE_REFRESH_INTERVAL_HOURS=12

# Sync settings
POLL_INTERVAL_SECONDS=60
AMAZON_ALBUM_NAME=Echo Show

# Rate limiting: delay between photo uploads in milliseconds (default: 0 for no delay)
# Example: UPLOAD_DELAY_MS=1000 adds 1 second delay between uploads
# UPLOAD_DELAY_MS=0

# Health/metrics/admin HTTP server port (default: 3000)
# SERVER_PORT=3000

# Repo link shown in the admin sidebar — point it at your fork if you have one
# GITHUB_URL=https://github.com/farhad-a/alexa-photos

# Delete photos from Amazon when removed from iCloud (default: true)
# Set to false to keep all photos in Amazon (append-only mode)
SYNC_DELETIONS=true

# Notifications (all optional)
# Send alerts when cookie refresh fails or other critical errors occur

# Throttle notifications to avoid spamming (default: 60 minutes between same alert)
# Set to -1 to throttle indefinitely (only send first occurrence of each alert)
# NOTIFICATION_THROTTLE_MINUTES=60

# Generic webhook URL (receives JSON POST with message, level, timestamp, details)
# ALERT_WEBHOOK_URL=https://your-webhook-url

# Pushover push notifications (https://pushover.net)
# PUSHOVER_USER=your-user-key-here
# PUSHOVER_TOKEN=your-app-token-here

# Logging
LOG_LEVEL=info
